{
  "name": "raj-raani-collections",
  "version": "0.1.0",
  "private": true,
  "description": "Raj Raani Collections - Indian lehenga & occasionwear storefront and store-owner admin",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-rajraani --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:fresh": "firebase emulators:start --only auth,firestore,storage --project demo-rajraani",
    "seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "reset": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/reset.ts",
    "make-admin": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/make-admin.ts",
    "migrate:ttl": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/migrate-ttl.ts",
    "jobs:expire": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/jobs.ts expire",
    "jobs:outbox": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/jobs.ts outbox",
    "jobs:refunds": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/jobs.ts refunds",
    "jobs:purge": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/jobs.ts purge",
    "jobs:reconcile": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/jobs.ts reconcile",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "firebase emulators:exec --only firestore,auth --project demo-rajraani \"vitest run --project integration\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-rajraani \"vitest run --project rules\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "art": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/generate-demo-art.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.52.0",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "firebase-tools": "^15.32.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    }
  }
}
