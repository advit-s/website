# Copy to .env.local for local development. NEVER commit real secrets. NEXT_PUBLIC_* values are readable by every visitor.

# ---- Mode -------------------------------------------------------------------------------------------
# local | staging | production.  production REQUIRES INTEGRATION_MODE=live and refuses emulator hosts.
APP_ENV=local
# simulated | live.  "simulated" = clearly labelled local stand-ins for Razorpay / Shiprocket / messaging / Anthropic.
INTEGRATION_MODE=simulated
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INTEGRATION_MODE=simulated

# ---- Firebase emulators (local only) ------------------------------------------------------------------
NEXT_PUBLIC_USE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---- Firebase web config (PUBLIC identifiers). Demo values work with emulators only. --------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-rajraani
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-rajraani.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-rajraani.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# ---- Firebase Admin (SERVER ONLY, production only; prefer Application Default Credentials on App Hosting) ---
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ---- Razorpay (live mode only) -------------------------------------------------------------------------
# Key ID is public; secret and webhook secret are SERVER ONLY.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (live mode only; SERVER ONLY) ----------------------------------------------------------
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION=
# Token configured in Shiprocket > Settings > API > Webhooks; sent back as the x-api-key header.
# SHIPROCKET_WEBHOOK_TOKEN=

# ---- Anthropic (assistants; SERVER ONLY) ---------------------------------------------------------------
# ANTHROPIC_API_KEY=
# Model id from the current Anthropic models page (docs/OWNER_SETUP.md) - do not guess.
# ANTHROPIC_MODEL=

# ---- Internal secrets (generate long random strings; SERVER ONLY) ---------------------------------------
# Signs scoped guest order-access tokens.
ORDER_TOKEN_SECRET=local-dev-order-token-secret-change-me
# Authorises /api/jobs/* (Cloud Scheduler or `npm run jobs:*`).
JOB_SECRET=local-dev-job-secret-change-me
# Signs simulated provider webhooks locally. Ignored in live mode.
SIMULATION_SECRET=local-simulation-secret-not-for-production

# ---- Seed ----------------------------------------------------------------------------------------------
# Password for emulator-only demo accounts (admin@/customer@/customer2@rajraani.test).
# SEED_DEMO_PASSWORD=Demo#Passw0rd
